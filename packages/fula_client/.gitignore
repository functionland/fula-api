# Native libraries (built by CI)
android/src/main/jniLibs/**/*.so
ios/Frameworks/*.xcframework
ios/Frameworks/**

# Keep directory structure
!android/src/main/jniLibs/.gitkeep
!ios/Frameworks/.gitkeep

# Flutter/Dart build artifacts
.dart_tool/
.packages
build/
*.iml
pubspec.lock

